# grow-my-money — NON-SECRET tunables only.
# Copy to .env and edit. NEVER put the Coinbase key or SMTP password here;
# those are read at runtime from mode-600 files outside the repo (see README).

# --- Mode -------------------------------------------------------------------
# paper | live. Defaults to paper. The PERSISTED mode in SQLite is the source of
# truth once `cli set-mode` has been run; this only seeds a fresh database.
MODE=paper

# Simulated starting cash for the paper epoch (also the paper benchmark capital).
PAPER_START_BANKROLL=10000

# --- Products & candles -----------------------------------------------------
# Fallback list only — used on first run and if product discovery is disabled
# or fails.
PRODUCTS=BTC-USD,ETH-USD,SOL-USD

# Dynamic product-universe discovery: refetches Coinbase's full USD spot
# catalog at startup and nightly, keeps every pair clearing the 24h USD-volume
# floor, ranked by volume, capped at MAX_COUNT. BTC/ETH/SOL always included.
# Set ENABLED=false to pin to the static PRODUCTS list above instead.
PRODUCT_DISCOVERY_ENABLED=true
PRODUCT_MIN_QUOTE_VOLUME_24H=5000000
PRODUCT_DISCOVERY_MAX_COUNT=40

CANDLE_GRANULARITY=ONE_HOUR
CANDLE_LIMIT=300

# --- Decision loop ----------------------------------------------------------
DECISION_INTERVAL_MIN=30
DAILY_REPORT_HOUR=8

# --- Safety caps (fractions of bankroll unless noted) -----------------------
PORTFOLIO_HALT_FRACTION=0.70
MAX_TRADES_PER_24H=5
MIN_ORDER_USD=10
# Emergency de-risk: sell all positions to cash when the halt trips.
# Off by default. See README go-live checklist before enabling.
HALT_AUTO_FLATTEN=false

# --- Execution / paper sim --------------------------------------------------
SLIPPAGE_BPS=5
FEE_BPS=60
PER_TRADE_BUDGET_FRACTION=0.10

# --- Model ------------------------------------------------------------------
MODEL_HORIZON_HOURS=6
BUY_PROBABILITY_THRESHOLD=0.55
MODEL_MIN_TRAIN_SAMPLES=40
RETRAIN_EVERY_N_CLOSED_TRADES=10
MODEL_PROMOTE_MAX_REGRESSION=0.02

# --- Indicators -------------------------------------------------------------
EMA_FAST=12
EMA_SLOW=26
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# --- Email (SMTP host/port/from are non-secret; PASSWORD is NOT here) -------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=ericfaris@gmail.com
REPORT_RECIPIENT=ericfaris@gmail.com

# --- Credential file paths (host defaults; container overrides to /run/secrets)
COINBASE_KEY_FILE=
SMTP_CREDS_FILE=
# CryptoPanic API token file (host default ~/.config/coinbase/grow-my-money.cryptopanic;
# container overrides to /run/secrets/cryptopanic.token). Empty/no file => inert.
CRYPTOPANIC_TOKEN_FILE=

# --- News sentiment (optional; fail-open, inert until a token file exists) ----
# Master switch. When true a SentimentProvider is built, but every lookup still
# fails open (proceeds unchanged) until the CryptoPanic token file is present.
SENTIMENT_ENABLED=true
# TTL (seconds) for the per-product sentiment cache (caps API calls).
SENTIMENT_TTL_SEC=900
# CryptoPanic posts endpoint (parametrized so it can be corrected without code).
SENTIMENT_API_BASE=https://cryptopanic.com/api/developer/v2/posts/
# Net vote lean in [-1,+1] (negative = bearish). At/below dampen => resize down;
# at/below veto => reject the buy. Buys only; sells are never affected.
SENTIMENT_DAMPEN_SCORE=-0.3
SENTIMENT_VETO_SCORE=-0.6
# Multiplier applied to the buy notional when dampening.
SENTIMENT_DAMPEN_FACTOR=0.5
# HTTP timeout (seconds) for the sentiment fetch.
SENTIMENT_TIMEOUT_SEC=4.0

# --- Volume + HTF confirmation (buys only) -----------------------------------
# Soft dampeners on buy sizing only; never zero the order, never block it.
# Trailing window (candles) for the volume SMA used to compute volume_ratio.
VOLUME_AVG_WINDOW=20
# volume_ratio >= this => full conviction (size_factor volume component = 1.0).
VOLUME_CONFIRM_RATIO=1.2
# volume_ratio <= this => fully dampened (size_factor volume component = VOLUME_THIN_FACTOR).
VOLUME_THIN_RATIO=0.7
# Volume-component floor multiplier when volume is thin.
VOLUME_THIN_FACTOR=0.6
# Higher-timeframe candle granularity used for the trend-confirmation fetch.
HTF_CANDLE_GRANULARITY=SIX_HOUR
# Multiplier applied when the HTF trend disagrees with a bullish buy signal.
HTF_DISAGREE_FACTOR=0.5

# --- Dashboard (read-only web UI; local loopback only) ----------------------
# Bind 0.0.0.0 INSIDE the container; host exposure is restricted to loopback by
# the compose ports mapping (127.0.0.1:8420:8420). Do not change the bind to
# 127.0.0.1 or the Docker port bridge cannot reach it.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8420
# How often the page polls /api/data (seconds).
DASHBOARD_REFRESH_SEC=15
# TTL for the dashboard's own spot-price cache (seconds) — caps Coinbase calls.
DASHBOARD_PRICE_TTL_SEC=20
